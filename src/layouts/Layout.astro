---
import '../styles/global.css';

interface Props {
	 title?: string;
	 description?: string;
}

const {
	 title = 'Kibo | Your desktop wellness companion',
	 description = 'Kibo is a friendly desktop companion that helps you take healthier breaks while you work.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
