---
import ProcessStep from '../ui/ProcessStep.astro';
---

<section id="how-it-works" class="process section-space" aria-labelledby="process-title">
	<div class="site-container">
		<div class="section-heading">
			<p class="eyebrow">A calmer rhythm</p>
			<h2 id="process-title">Kibo fits into<br />your workday.</h2>
		</div>

		<div class="process-grid">
			<ProcessStep
				icon="download"
				number="01"
				title="Install Kibo"
				description="Bring a small wellness companion to your desktop."
			/>
			<ProcessStep
				icon="settings"
				number="02"
				title="Choose your intervals"
				description="Set reminder intervals that fit the way you work."
			/>
			<ProcessStep
				icon="laptop"
				number="03"
				title="Keep working"
				description="Stay focused while Kibo quietly keeps watch."
			/>
			<ProcessStep
				icon="bell"
				number="04"
				title="Take better breaks"
				description="When it is time, pause and take care of yourself."
			/>
		</div>
	</div>
</section>

<style>
	.process {
		background: var(--kibo-color-canvas);
	}

	.section-heading {
		max-width: 34rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.3;
		text-transform: uppercase;
		color: var(--kibo-color-accent-strong);
	}

	h2 {
		margin: 0;
		font-size: clamp(2.25rem, 8vw, 4.5rem);
		font-weight: 650;
		letter-spacing: -0.055em;
		line-height: 1;
	}

	.process-grid {
		display: grid;
		gap: 2.5rem;
		margin-top: 3rem;
	}

	@media (min-width: 48rem) {
		.process-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1.5rem;
			margin-top: 5rem;
		}
	}
</style>
